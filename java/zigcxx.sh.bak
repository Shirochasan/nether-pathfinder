#!/bin/sh
if [ -n "$ZIG_TARGET" ]; then
  has_target=false
  for arg in "$@"; do
    case "$arg" in
      -target|--target|--target=*)
        has_target=true
        break
        ;;
    esac
  done
  if [ "$has_target" = false ]; then
    set -- -target "$ZIG_TARGET" "$@"
  fi
fi
exec /usr/local/bin/zig c++ "$@"
